# ── CryptoDash environment ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# runtime: development | production
APP_ENV=development
PUBLIC_HOST=localhost
BACKEND_PORT=8400

# In production APP_ENV must be "production" which forces HTTPS + Secure cookies.
# Behind Caddy/nginx terminate TLS there; set TRUE if a reverse proxy terminates it.
FORCE_HTTPS=false

# Secret used to sign server-side session tokens (itsdangerous).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-please-generate-a-long-random-string

# Master key for at-rest encryption of user-supplied API keys (Fernet format: 32 url-safe bytes)
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MASTER_KEY=change-me-please-generate-a-fernet-key

# Optional FRED key — unlocks US M2 money supply (M2SL), LBMA gold (PGOLDAMUSDM)
# and the BIS Global Liquidity Index (B465RL1M087SBOE). Free at fred.stlouisfed.org.
# Without it, M2/liquidity are hidden but everything else (BTC/gold/Brent via Yahoo + Binance) still works.
FRED_API_KEY=

# Gold is additionally cross-checked against a keyless live XAU/USD spot (goldprice.dev).

# Data source toggles
BINANCE_BASE=https://api.binance.com
YAHOO_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126 Safari/537.36

# Rate limits (requests per window)
RL_AUTH_PER_MIN=5          # login/register attempts per user+ip
RL_API_PER_MIN=120         # general API per session/ip
RL_ANALYSIS_PER_MIN=40     # heavy analysis endpoint

# Logging
LOG_LEVEL=INFO
