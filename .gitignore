# Secrets & local state — never commit
.env
*.pem
*.key
!deploy/*.md

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Project data (embedded postgres cluster, caches) — anchor these to the repo root.
# A bare `data/` here would also match the *source package* backend/src/cryptodash/data/.
/data/
backend/data/
!backend/src/cryptodash/data/
*.db

# Node / frontend
node_modules/
frontend/dist/
npm-debug.log*

# OS noise
.DS_Store
Thumbs.db

# CodeGraph local index
.codegraph/

# throwaway exploration scripts
backend/probe_*.py

# Offline distribution kits (large binary bundles; regenerate, never commit)
offline-kits/
deploy/certs/
